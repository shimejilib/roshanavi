<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>roshanavi_examples</name>
  <version>0.1.0</version>
  <description>Sample nodes for roshanavi tutorials, demos and tests: image_filter and blob_detector (C++), audio_level, state_machine and executor_busy_demo (Python); the relay pipeline sample pipeline_source / pipeline_relay / pipeline_sink (C++, composable and standalone) with its launch builder</description>
  <maintainer email="yuya.aoki.0928@gmail.com">aoki</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>roshanavi_examples_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>vision_msgs</depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <!-- only for audio_level with input_type "stamped" (the default) -->
  <exec_depend>audio_common_msgs</exec_depend>
  <!-- only for the image function of logic.py (function node example) -->
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
